{
  "name": "student-app",
  "version": "1.0.0",
  "description": "Student Portal App - Minimal Setup",
  "main": "node_modules/expo/AppEntry.js",
  "private": true,
  "scripts": {
    "start": "npx expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "npx expo start --web"
  },
  "dependencies": {
    "@react-navigation/native": "^7.1.28",
    "@react-navigation/stack": "^7.1.0",
    "@types/react": "~18.2.79",
    "axios": "^1.6.5",
    "expo": "~51.0.0",
    "expo-secure-store": "~13.0.0",
    "expo-status-bar": "~1.12.1",
    "react": "18.2.0",
    "react-native": "0.74.5",
    "react-native-gesture-handler": "~2.16.1",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "~3.31.1",
    "typescript": "~5.3.3"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0"
  },
  "expo": {
    "name": "Student App",
    "slug": "student-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.enromatics.studentapp"
    }

# Authentication
NEXTAUTH_SECRET=your-secret-key-here
NEXTAUTH_URL=http://localhost:5000
JWT_SECRET=your-jwt-secret-here

# Database
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database-name

# Facebook Business API
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret

# WhatsApp Cloud API
WHASTAPPAPP_ID=your-whatsapp-app-id
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_BUSINESS_ACCOUNT_ID=your-business-account-id
WHATSAPP_ACCESS_TOKEN=your-access-token
META_APP_SECRET=your-meta-app-secret
META_API_VERSION=v21.0

# Super Admin
SUPER_ADMIN_EMAIL=admin@yourdomain.com

# ZeptoMail Configuration (HTTP REST API)
# India DC: https://api.zeptomail.in/v1.1/email | US/Global DC: https://api.zeptomail.com/v1.1/email
ZEPTO_API_URL=https://api.zeptomail.in/v1.1/email
# ZeptoMail Send Mail Token (can be 'Zoho-enczapikey <key>' or just '<key>')
ZEPTO_API_TOKEN=Zoho-enczapikey your-send-mail-token-here
# Verified sender email address configured in your ZeptoMail Mail Agent
ZEPTO_FROM=no-reply@enromatics.com
EMAIL_FROM=no-reply@enromatics.com
ZEPTO_AGENT=your-mail-agent-id

# Server Configuration
PORT=5050
NODE_ENV=development
